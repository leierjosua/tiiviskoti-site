      "destination": "/tikkurilan-omakotiyhdistys.html"
    },
    {
      "source": "/nikinmaen-omakotiyhdistys",
      "destination": "/nikinmaen-omakotiyhdistys.html"
    },
    {
      "source": "/keravan-omakotiyhdistys",
      "destination": "/keravan-omakotiyhdistys.html"
    },
    {
      "source": "/keravan-jokivarren-omakotiyhdistys",
      "destination": "/keravan-jokivarren-omakotiyhdistys.html"
    },
    {
