{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": false,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true, "noEmit": true
  },
  "include": ["src"]
}
